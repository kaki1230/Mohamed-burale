<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Cantilever — Architect-Designed Homes</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300;9..144,400;9..144,500;9..144,600&family=Inter:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
  :root{
    --sand:#EDE7DA;
    --paper:#F8F5EE;
    --ink:#26281F;
    --ink-soft:#4A4C3F;
    --pine:#5C6B4C;
    --pine-deep:#40492F;
    --brass:#A9824F;
    --line:rgba(38,40,31,0.15);
    --radius:2px;
  }
  *{box-sizing:border-box; margin:0; padding:0;}
  html{scroll-behavior:smooth;}
  body{
    background:var(--sand);
    color:var(--ink);
    font-family:'Inter', sans-serif;
    font-size:16px;
    line-height:1.6;
    -webkit-font-smoothing:antialiased;
  }
  h1,h2,h3,.display{
    font-family:'Fraunces', serif;
    font-weight:500;
    letter-spacing:-0.01em;
    line-height:1.05;
  }
  .mono{
    font-family:'IBM Plex Mono', monospace;
    letter-spacing:0.02em;
  }
  .eyebrow{
    font-family:'IBM Plex Mono', monospace;
    font-size:11px;
    letter-spacing:0.18em;
    text-transform:uppercase;
    color:var(--pine-deep);
  }
  a{color:inherit; text-decoration:none;}
  .wrap{max-width:1180px; margin:0 auto; padding:0 40px;}
  @media(max-width:700px){.wrap{padding:0 22px;}}

  /* NAV */
  nav{
    position:sticky; top:0; z-index:50;
    background:rgba(237,231,218,0.92);
    backdrop-filter:blur(6px);
    border-bottom:1px solid var(--line);
  }
  nav .wrap{display:flex; align-items:center; justify-content:space-between; height:74px;}
  .logo{display:flex; align-items:center; gap:10px; font-family:'Fraunces',serif; font-size:19px; font-weight:600;}
  .logo svg{display:block;}
  nav ul{display:flex; gap:34px; list-style:none;}
  nav ul li a{font-size:13px; letter-spacing:0.03em; color:var(--ink-soft); transition:color .2s;}
  nav ul li a:hover{color:var(--pine-deep);}
  .nav-cta{
    font-size:12.5px; letter-spacing:0.03em; padding:10px 20px;
    border:1px solid var(--ink); border-radius:var(--radius);
    transition:background .2s, color .2s;
  }
  .nav-cta:hover{background:var(--ink); color:var(--paper);}
  @media(max-width:820px){nav ul{display:none;}}

  /* HERO */
  .hero{position:relative; overflow:hidden; padding:96px 0 0;}
  .hero .wrap{display:grid; grid-template-columns:1.05fr 0.95fr; gap:40px; align-items:center;}
  @media(max-width:900px){.hero .wrap{grid-template-columns:1fr; padding-bottom:40px;}}
  .hero-eyebrow{margin-bottom:22px;}
  .hero h1{font-size:clamp(38px,5vw,64px); max-width:11ch;}
  .hero h1 em{font-style:italic; color:var(--pine-deep);}
  .hero p.lede{margin-top:22px; max-width:38ch; color:var(--ink-soft); font-size:16.5px;}
  .hero-actions{display:flex; gap:16px; margin-top:34px; flex-wrap:wrap;}
  .btn-primary{
    background:var(--ink); color:var(--paper); padding:14px 26px;
    font-size:13px; letter-spacing:0.03em; border-radius:var(--radius);
    display:inline-block; transition:background .2s;
  }
  .btn-primary:hover{background:var(--pine-deep);}
  .btn-ghost{
    padding:14px 22px; font-size:13px; letter-spacing:0.03em;
    border-bottom:1px solid var(--ink); display:inline-flex; align-items:center; gap:8px;
  }
  .hero-art{position:relative;}
  .hero-stats{
    display:flex; gap:0; margin-top:70px; border-top:1px solid var(--line);
  }
  .hero-stats .stat{flex:1; padding:22px 0 0; border-right:1px solid var(--line);}
  .hero-stats .stat:last-child{border-right:none;}
  .hero-stats .stat b{display:block; font-family:'Fraunces',serif; font-size:26px; font-weight:500;}
  .hero-stats .stat span{font-size:12px; color:var(--ink-soft);}

  /* SECTION HEADERS */
  .section{padding:110px 0;}
  .section-head{display:flex; justify-content:space-between; align-items:flex-end; gap:30px; margin-bottom:56px; border-bottom:1px solid var(--line); padding-bottom:26px;}
  .section-head h2{font-size:clamp(28px,3.4vw,40px);}
  .section-head p{max-width:34ch; color:var(--ink-soft); font-size:14.5px;}
  @media(max-width:700px){.section-head{flex-direction:column; align-items:flex-start;}}

  /* LISTINGS */
  .listings{background:var(--paper); border-top:1px solid var(--line); border-bottom:1px solid var(--line);}
  .listing-grid{display:grid; grid-template-columns:repeat(3,1fr); gap:1px; background:var(--line); border:1px solid var(--line);}
  @media(max-width:900px){.listing-grid{grid-template-columns:1fr;}}
  .card{background:var(--paper); padding:34px 30px 30px; display:flex; flex-direction:column; transition:background .25s;}
  .card:hover{background:var(--sand);}
  .card .plan{height:150px; display:flex; align-items:center; justify-content:center; margin-bottom:22px;}
  .card .plan svg{width:100%; height:100%;}
  .card .status{font-size:10.5px; letter-spacing:0.14em; text-transform:uppercase; color:var(--brass); margin-bottom:10px;}
  .card h3{font-size:20px; margin-bottom:4px;}
  .card .loc{font-size:13px; color:var(--ink-soft); margin-bottom:18px;}
  .card .specs{display:flex; gap:16px; font-size:12px; color:var(--ink-soft); border-top:1px solid var(--line); padding-top:16px; margin-top:auto;}
  .card .price{font-family:'Fraunces',serif; font-size:22px; margin-top:16px;}

  /* PHILOSOPHY */
  .philosophy .wrap{display:grid; grid-template-columns:0.9fr 1.1fr; gap:70px; align-items:start;}
  @media(max-width:900px){.philosophy .wrap{grid-template-columns:1fr; gap:40px;}}
  .philosophy blockquote{font-family:'Fraunces',serif; font-size:clamp(24px,2.6vw,32px); font-weight:400; line-height:1.35; color:var(--ink);}
  .philosophy blockquote span{color:var(--pine-deep); font-style:italic;}
  .principles{display:flex; flex-direction:column; gap:0;}
  .principle{display:flex; gap:22px; padding:26px 0; border-top:1px solid var(--line);}
  .principle:last-child{border-bottom:1px solid var(--line);}
  .principle .mark{font-family:'IBM Plex Mono',monospace; font-size:12px; color:var(--brass); padding-top:4px; width:38px; flex-shrink:0;}
  .principle h4{font-size:16px; margin-bottom:6px;}
  .principle p{font-size:13.5px; color:var(--ink-soft);}

  /* PROCESS */
  .process{background:var(--pine-deep); color:var(--paper);}
  .process .section-head{border-color:rgba(248,245,238,0.18);}
  .process .section-head p{color:rgba(248,245,238,0.7);}
  .process-row{display:grid; grid-template-columns:repeat(4,1fr); gap:34px;}
  @media(max-width:900px){.process-row{grid-template-columns:1fr 1fr;}}
  @media(max-width:560px){.process-row{grid-template-columns:1fr;}}
  .step .num{font-family:'IBM Plex Mono',monospace; font-size:12px; color:var(--brass); margin-bottom:16px; display:block;}
  .step h4{font-family:'Fraunces',serif; font-size:19px; font-weight:500; margin-bottom:10px;}
  .step p{font-size:13.5px; color:rgba(248,245,238,0.68);}

  /* AGENTS */
  .agent-grid{display:grid; grid-template-columns:repeat(4,1fr); gap:36px;}
  @media(max-width:900px){.agent-grid{grid-template-columns:repeat(2,1fr);}}
  @media(max-width:560px){.agent-grid{grid-template-columns:1fr;}}
  .agent .avatar{width:100%; aspect-ratio:4/5; background:var(--sand); border:1px solid var(--line); margin-bottom:16px; display:flex; align-items:center; justify-content:center;}
  .agent h4{font-size:16px;}
  .agent .role{font-size:12px; color:var(--ink-soft); margin-top:2px;}

  /* CONTACT / FOOTER */
  footer{background:var(--ink); color:var(--paper);}
  .contact-band{display:grid; grid-template-columns:1.1fr 0.9fr; gap:60px; padding:100px 0 70px; border-bottom:1px solid rgba(248,245,238,0.14);}
  @media(max-width:900px){.contact-band{grid-template-columns:1fr; padding:70px 0 50px;}}
  .contact-band h2{font-size:clamp(30px,4vw,46px); max-width:12ch; margin-bottom:24px;}
  .contact-band p{color:rgba(248,245,238,0.65); max-width:40ch; margin-bottom:30px;}
  .form{display:flex; flex-direction:column; gap:14px;}
  .form input, .form textarea{
    background:transparent; border:none; border-bottom:1px solid rgba(248,245,238,0.3);
    color:var(--paper); font-family:'Inter',sans-serif; font-size:14px; padding:12px 2px;
  }
  .form input::placeholder, .form textarea::placeholder{color:rgba(248,245,238,0.45);}
  .form input:focus, .form textarea:focus{outline:none; border-color:var(--brass);}
  .form button{
    margin-top:12px; align-self:flex-start; background:var(--brass); color:var(--ink);
    padding:14px 28px; font-size:13px; letter-spacing:0.03em; border:none; border-radius:var(--radius); cursor:pointer;
  }
  .contact-info{display:flex; flex-direction:column; gap:24px; justify-content:center;}
  .contact-info .item{border-top:1px solid rgba(248,245,238,0.14); padding-top:16px;}
  .contact-info .item .label{font-size:11px; letter-spacing:0.12em; text-transform:uppercase; color:rgba(248,245,238,0.5); margin-bottom:6px;}
  .contact-info .item .val{font-family:'Fraunces',serif; font-size:19px;}
  .foot-bottom{display:flex; justify-content:space-between; align-items:center; padding:26px 0; font-size:12px; color:rgba(248,245,238,0.5); flex-wrap:wrap; gap:12px;}

  ::selection{background:var(--brass); color:var(--ink);}
  :focus-visible{outline:2px solid var(--brass); outline-offset:2px;}
  @media (prefers-reduced-motion: reduce){ *{transition:none !important; scroll-behavior:auto !important;} }
</style>
</head>
<body>

<nav>
  <div class="wrap">
    <div class="logo">
      <svg width="26" height="26" viewBox="0 0 26 26" fill="none">
        <path d="M2 20 L2 12 L13 6 L24 12 L24 20" stroke="#26281F" stroke-width="1.6"/>
        <path d="M13 6 L13 26" stroke="#A9824F" stroke-width="1.6"/>
      </svg>
      Cantilever
    </div>
    <ul>
      <li><a href="#listings">Listings</a></li>
      <li><a href="#philosophy">Approach</a></li>
      <li><a href="#process">Process</a></li>
      <li><a href="#agents">Agents</a></li>
    </ul>
    <a href="#contact" class="nav-cta">Book a walkthrough</a>
  </div>
</nav>

<header class="hero">
  <div class="wrap">
    <div>
      <div class="eyebrow hero-eyebrow">Architect-designed &nbsp;·&nbsp; Est. 1991</div>
      <h1>Homes built on <em>drawings</em>, not templates.</h1>
      <p class="lede">Cantilever represents architect-designed and structurally distinctive homes across the coastal hillside — each one sold with its original plans, not just its listing photos.</p>
      <div class="hero-actions">
        <a href="#listings" class="btn-primary">View current listings</a>
        <a href="#philosophy" class="btn-ghost">Our approach →</a>
      </div>
      <div class="hero-stats">
        <div class="stat"><b>142</b><span>Homes placed since 1991</span></div>
        <div class="stat"><b>19</b><span>Architects in active rotation</span></div>
        <div class="stat"><b>31 yrs</b><span>Average agent tenure</span></div>
      </div>
    </div>
    <div class="hero-art">
      <svg viewBox="0 0 480 420" width="100%" height="100%" fill="none">
        <!-- hillside -->
        <path d="M0 340 Q 120 300 240 330 T 480 310 V420 H0 Z" fill="#E3DCC9"/>
        <!-- cantilevered structure line art -->
        <rect x="120" y="150" width="10" height="180" fill="none" stroke="#26281F" stroke-width="1.4"/>
        <path d="M60 190 H 340" stroke="#26281F" stroke-width="2"/>
        <path d="M60 190 L60 260" stroke="#26281F" stroke-width="1.4"/>
        <path d="M340 190 L340 220" stroke="#26281F" stroke-width="1.4"/>
        <path d="M100 190 V150 H300 V190" stroke="#5C6B4C" stroke-width="1.6"/>
        <path d="M100 150 L60 190" stroke="#5C6B4C" stroke-width="1.2" stroke-dasharray="3 3"/>
        <circle cx="240" cy="170" r="1.6" fill="#A9824F"/>
        <path d="M230 160 L250 160 L250 180 L230 180 Z" stroke="#A9824F" stroke-width="1.2" fill="none"/>
        <path d="M0 330 H480" stroke="#26281F" stroke-width="0.6" stroke-dasharray="2 4" opacity="0.4"/>
        <text x="60" y="360" font-family="IBM Plex Mono" font-size="10" fill="#4A4C3F" letter-spacing="1">EL. 340&#39; — RIDGELINE PARCEL 07</text>
      </svg>
    </div>
  </div>
</header>

<section class="listings" id="listings">
  <div class="wrap section">
    <div class="section-head">
      <div>
        <div class="eyebrow" style="margin-bottom:14px;">Current listings</div>
        <h2>Three homes, three architects.</h2>
      </div>
      <p>Every listing here ships with the original construction drawings, available on request during your walkthrough.</p>
    </div>
  </div>
  <div class="wrap" style="padding-bottom:0;">
    <div class="listing-grid">

      <div class="card">
        <div class="status">New listing</div>
        <div class="plan">
          <svg viewBox="0 0 200 130" fill="none">
            <path d="M20 100 L20 40 L100 15 L180 40 L180 100 Z" stroke="#26281F" stroke-width="1.3"/>
            <path d="M20 60 H180" stroke="#26281F" stroke-width="0.7" opacity="0.5"/>
            <path d="M100 15 V100" stroke="#26281F" stroke-width="0.7" opacity="0.5"/>
            <rect x="45" y="70" width="24" height="30" stroke="#5C6B4C" stroke-width="1"/>
            <rect x="130" y="70" width="24" height="30" stroke="#5C6B4C" stroke-width="1"/>
          </svg>
        </div>
        <h3>The Larkin Ridge House</h3>
        <div class="loc">Larkin Ridge, Sector 4 &nbsp;·&nbsp; 1968, restored 2019</div>
        <div class="specs">
          <span>4 bd</span><span>3 ba</span><span>2,940 sqft</span><span>0.6 acre</span>
        </div>
        <div class="price mono">$2,480,000</div>
      </div>

      <div class="card">
        <div class="status">Open Saturday</div>
        <div class="plan">
          <svg viewBox="0 0 200 130" fill="none">
            <path d="M15 100 L15 50 H90 L110 20 L185 50 V100 Z" stroke="#26281F" stroke-width="1.3"/>
            <path d="M90 50 V100" stroke="#26281F" stroke-width="0.7" opacity="0.5"/>
            <circle cx="150" cy="75" r="14" stroke="#A9824F" stroke-width="1"/>
          </svg>
        </div>
        <h3>Sorrel Court Residence</h3>
        <div class="loc">Sorrel Court &nbsp;·&nbsp; 1974, original condition</div>
        <div class="specs">
          <span>3 bd</span><span>2 ba</span><span>2,110 sqft</span><span>0.3 acre</span>
        </div>
        <div class="price mono">$1,795,000</div>
      </div>

      <div class="card">
        <div class="status">Under offer</div>
        <div class="plan">
          <svg viewBox="0 0 200 130" fill="none">
            <path d="M20 100 V45 L60 45 L60 20 L140 20 L140 45 L180 45 V100 Z" stroke="#26281F" stroke-width="1.3"/>
            <path d="M60 45 H140" stroke="#26281F" stroke-width="0.7" opacity="0.5"/>
            <rect x="90" y="65" width="20" height="35" stroke="#5C6B4C" stroke-width="1"/>
          </svg>
        </div>
        <h3>The Averill Split-Level</h3>
        <div class="loc">Averill Heights &nbsp;·&nbsp; 1961, mid-century</div>
        <div class="specs">
          <span>5 bd</span><span>3.5 ba</span><span>3,420 sqft</span><span>0.8 acre</span>
        </div>
        <div class="price mono">$3,150,000</div>
      </div>

    </div>
  </div>
</section>

<section class="philosophy section" id="philosophy">
  <div class="wrap">
    <blockquote>We don't sell square footage. <span>We sell the reasoning behind every wall.</span></blockquote>
    <div class="principles">
      <div class="principle">
        <div class="mark">01</div>
        <div><h4>Provenance first</h4><p>Every listing includes its architect, its year, and — where they still exist — the original drawings. Buyers get the story, not just the staging.</p></div>
      </div>
      <div class="principle">
        <div class="mark">02</div>
        <div><h4>Agents who read plans</h4><p>Our team trained alongside structural engineers before they ever wrote a listing. They can tell you why a roofline works, not just what it looks like.</p></div>
      </div>
      <div class="principle">
        <div class="mark">03</div>
        <div><h4>No renovations that erase intent</h4><p>We flag any structural changes made since original construction, and connect buyers with architects who can restore rather than replace.</p></div>
      </div>
    </div>
  </div>
</section>

<section class="process" id="process">
  <div class="wrap section">
    <div class="section-head">
      <div>
        <div class="eyebrow" style="margin-bottom:14px; color:var(--brass);">How it works</div>
        <h2>From first walkthrough to keys, in four stages.</h2>
      </div>
      <p>This is a fixed sequence — each stage depends on the one before it.</p>
    </div>
    <div class="process-row">
      <div class="step"><span class="num">STAGE 01</span><h4>Site walkthrough</h4><p>You tour the home with an agent and, where possible, the original architect's drawings side by side.</p></div>
      <div class="step"><span class="num">STAGE 02</span><h4>Structural review</h4><p>An independent engineer confirms the home matches its as-built plans before any offer is drafted.</p></div>
      <div class="step"><span class="num">STAGE 03</span><h4>Offer &amp; provenance file</h4><p>Your offer is submitted alongside a provenance file: permits, past renovations, and architect correspondence.</p></div>
      <div class="step"><span class="num">STAGE 04</span><h4>Close &amp; handover</h4><p>You receive the keys, the original drawings, and an introduction to the architect's estate where one exists.</p></div>
    </div>
  </div>
</section>

<section class="section" id="agents">
  <div class="wrap">
    <div class="section-head">
      <div>
        <div class="eyebrow" style="margin-bottom:14px;">The team</div>
        <h2>Four agents, one shared library of plans.</h2>
      </div>
      <p>Each agent specializes in a different architectural era of the hillside.</p>
    </div>
    <div class="agent-grid">
      <div class="agent">
        <div class="avatar">
          <svg width="40" height="40" viewBox="0 0 40 40"><circle cx="20" cy="14" r="8" stroke="#26281F" stroke-width="1.2" fill="none"/><path d="M6 36 Q20 20 34 36" stroke="#26281F" stroke-width="1.2" fill="none"/></svg>
        </div>
        <h4>Marguerite Voss</h4>
        <div class="role">Mid-century &amp; post-war</div>
      </div>
      <div class="agent">
        <div class="avatar">
          <svg width="40" height="40" viewBox="0 0 40 40"><circle cx="20" cy="14" r="8" stroke="#26281F" stroke-width="1.2" fill="none"/><path d="M6 36 Q20 20 34 36" stroke="#26281F" stroke-width="1.2" fill="none"/></svg>
        </div>
        <h4>Desmond Achebe</h4>
        <div class="role">Brutalist &amp; concrete-form</div>
      </div>
      <div class="agent">
        <div class="avatar">
          <svg width="40" height="40" viewBox="0 0 40 40"><circle cx="20" cy="14" r="8" stroke="#26281F" stroke-width="1.2" fill="none"/><path d="M6 36 Q20 20 34 36" stroke="#26281F" stroke-width="1.2" fill="none"/></svg>
        </div>
        <h4>Priya Sundaram</h4>
        <div class="role">Passive &amp; net-zero builds</div>
      </div>
      <div class="agent">
        <div class="avatar">
          <svg width="40" height="40" viewBox="0 0 40 40"><circle cx="20" cy="14" r="8" stroke="#26281F" stroke-width="1.2" fill="none"/><path d="M6 36 Q20 20 34 36" stroke="#26281F" stroke-width="1.2" fill="none"/></svg>
        </div>
        <h4>Elias Furlong</h4>
        <div class="role">Estate &amp; heritage sales</div>
      </div>
    </div>
  </div>
</section>

<footer id="contact">
  <div class="wrap contact-band">
    <div>
      <h2>Let's find your drawings.</h2>
      <p>Tell us what draws you to a house — the era, the materials, the light — and we'll match you with the agent whose library fits.</p>
      <form class="form" onsubmit="event.preventDefault();">
        <input type="text" placeholder="Full name">
        <input type="email" placeholder="Email address">
        <textarea rows="3" placeholder="What kind of home are you looking for?"></textarea>
        <button type="submit">Request an introduction</button>
      </form>
    </div>
    <div class="contact-info">
      <div class="item"><div class="label">Office</div><div class="val">Ridgeline Studio, Suite 4</div></div>
      <div class="item"><div class="label">Phone</div><div class="val">(415) 555-0142</div></div>
      <div class="item"><div class="label">Hours</div><div class="val">Tue–Sat, 9am–6pm</div></div>
    </div>
  </div>
  <div class="wrap foot-bottom">
    <span>© 2026 Cantilever Realty. All listings independently verified.</span>
    <span class="mono">DRE #01923847</span>
  </div>
</footer>

</body>
</html>
