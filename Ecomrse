<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Studio Kobo — Considered Objects for the Home</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,500&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
/* ============ TOKENS ============ */
:root{
  --ink:#211D18;
  --ink-soft:#4A443C;
  --muted:#8A8377;
  --bg:#F5F1E8;
  --surface:#FFFFFF;
  --surface-2:#EFEAE0;
  --border:#E1DACB;
  --rust:#A94A28;
  --rust-dark:#7E3A20;
  --sage:#5E7358;
  --sage-light:#EAF0E5;
  --gold:#B9924A;
  --danger:#AE3B2E;
  --danger-bg:#FBEBE8;
  --success:#456249;
  --radius-s:4px;
  --radius-m:10px;
  --radius-l:20px;
  --shadow-s:0 1px 2px rgba(33,29,24,.06);
  --shadow-m:0 6px 20px rgba(33,29,24,.08);
  --shadow-l:0 20px 60px rgba(33,29,24,.18);
  --serif:'Fraunces',serif;
  --sans:'Inter',sans-serif;
}
*{box-sizing:border-box;margin:0;padding:0;}
html{scroll-behavior:smooth;}
body{
  font-family:var(--sans);
  background:var(--bg);
  color:var(--ink);
  line-height:1.5;
  -webkit-font-smoothing:antialiased;
}
img{max-width:100%;display:block;}
a{color:inherit;text-decoration:none;}
button{font-family:inherit;cursor:pointer;border:none;background:none;color:inherit;}
input,select,textarea{font-family:inherit;font-size:14px;}
ul{list-style:none;}
:focus-visible{outline:2px solid var(--rust);outline-offset:2px;}
.wrap{max-width:1280px;margin:0 auto;padding:0 32px;}
@media(max-width:640px){.wrap{padding:0 18px;}}

h1,h2,h3,h4{font-family:var(--serif);font-weight:500;letter-spacing:-.01em;color:var(--ink);}
.eyebrow{
  font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--rust);
  font-weight:600;display:flex;align-items:center;gap:8px;margin-bottom:10px;
}
.eyebrow::before{content:'';width:16px;height:1px;background:var(--rust);}

.btn{
  display:inline-flex;align-items:center;justify-content:center;gap:8px;
  padding:13px 24px;border-radius:2px;font-size:13px;font-weight:600;
  letter-spacing:.03em;text-transform:uppercase;transition:all .18s ease;white-space:nowrap;
}
.btn-primary{background:var(--ink);color:#fff;}
.btn-primary:hover{background:var(--rust);}
.btn-outline{background:transparent;color:var(--ink);border:1px solid var(--ink);}
.btn-outline:hover{background:var(--ink);color:#fff;}
.btn-rust{background:var(--rust);color:#fff;}
.btn-rust:hover{background:var(--rust-dark);}
.btn-ghost{color:var(--ink-soft);text-decoration:underline;text-underline-offset:3px;}
.btn-sm{padding:9px 16px;font-size:11px;}
.btn-block{width:100%;}
.btn:disabled{opacity:.45;cursor:not-allowed;}
.btn-icon{width:38px;height:38px;border-radius:50%;display:inline-flex;align-items:center;justify-content:center;background:var(--surface-2);}
.btn-icon:hover{background:var(--ink);color:#fff;}

/* ============ TOP BAR / HEADER ============ */
.announce{background:var(--ink);color:#EDE7D9;font-size:12px;text-align:center;padding:9px 12px;letter-spacing:.03em;}
.announce b{color:var(--gold);}

header.site{position:sticky;top:0;z-index:60;background:rgba(245,241,232,.92);backdrop-filter:blur(10px);border-bottom:1px solid var(--border);}
.header-top{display:flex;align-items:center;gap:28px;padding:18px 0;}
.logo{font-family:var(--serif);font-size:24px;font-weight:600;letter-spacing:-.02em;display:flex;align-items:center;gap:8px;}
.logo span{color:var(--rust);}
.search-bar{flex:1;max-width:460px;position:relative;display:none;}
@media(min-width:900px){.search-bar{display:block;}}
.search-bar input{width:100%;padding:11px 40px 11px 16px;border:1px solid var(--border);border-radius:2px;background:var(--surface);font-size:13px;}
.search-bar svg{position:absolute;right:13px;top:50%;transform:translateY(-50%);width:16px;height:16px;color:var(--muted);}
.header-actions{display:flex;align-items:center;gap:6px;margin-left:auto;}
.icon-btn{position:relative;width:40px;height:40px;display:flex;align-items:center;justify-content:center;border-radius:50%;}
.icon-btn:hover{background:var(--surface-2);}
.icon-btn svg{width:20px;height:20px;}
.badge{position:absolute;top:2px;right:2px;background:var(--rust);color:#fff;font-size:9px;font-weight:700;width:16px;height:16px;border-radius:50%;display:flex;align-items:center;justify-content:center;}
.nav-row{border-top:1px solid var(--border);display:flex;align-items:center;gap:30px;padding:12px 0;overflow-x:auto;}
.nav-row a{font-size:13px;font-weight:500;white-space:nowrap;color:var(--ink-soft);transition:color .15s;}
.nav-row a:hover,.nav-row a.active{color:var(--rust);}
.mobile-search{display:block;padding:12px 0 0;}
@media(min-width:900px){.mobile-search{display:none;}}
.mobile-search input{width:100%;padding:10px 14px;border:1px solid var(--border);border-radius:2px;font-size:13px;}
.burger{display:flex;width:40px;height:40px;align-items:center;justify-content:center;}
@media(min-width:900px){.burger{display:none;}}

/* ============ FOOTER ============ */
footer.site{background:var(--ink);color:#D8D2C4;margin-top:100px;padding:70px 0 0;}
.footer-grid{display:grid;grid-template-columns:1.4fr 1fr 1fr 1.2fr;gap:40px;padding-bottom:50px;border-bottom:1px solid #3A352C;}
@media(max-width:800px){.footer-grid{grid-template-columns:1fr 1fr;}}
.footer-grid h4{color:#fff;font-size:13px;text-transform:uppercase;letter-spacing:.08em;margin-bottom:16px;font-family:var(--sans);font-weight:600;}
.footer-grid a{display:block;font-size:13px;color:#B8B1A2;padding:5px 0;}
.footer-grid a:hover{color:#fff;}
.footer-brand p{font-size:13px;color:#B8B1A2;margin-top:14px;max-width:280px;}
.footer-bottom{display:flex;justify-content:space-between;padding:22px 0;font-size:12px;color:#8C8676;flex-wrap:wrap;gap:10px;}
.newsletter-band{background:var(--sage-light);padding:56px 0;}
.newsletter-inner{display:flex;align-items:center;justify-content:space-between;gap:30px;flex-wrap:wrap;}
.newsletter-form{display:flex;gap:0;max-width:420px;width:100%;}
.newsletter-form input{flex:1;padding:13px 16px;border:1px solid var(--ink);border-right:none;font-size:13px;}
.newsletter-form button{padding:0 22px;background:var(--ink);color:#fff;font-size:12px;text-transform:uppercase;letter-spacing:.05em;font-weight:600;}

/* ============ HERO ============ */
.hero{position:relative;padding:70px 0 90px;overflow:hidden;}
.hero-grid{display:grid;grid-template-columns:1fr 1fr;gap:50px;align-items:center;}
@media(max-width:860px){.hero-grid{grid-template-columns:1fr;}}
.hero h1{font-size:clamp(38px,5.4vw,64px);line-height:1.02;margin-bottom:22px;}
.hero p{font-size:16px;color:var(--ink-soft);max-width:420px;margin-bottom:30px;}
.hero-actions{display:flex;gap:14px;flex-wrap:wrap;}
.hero-visual{position:relative;aspect-ratio:1/1;border-radius:var(--radius-l);background:linear-gradient(155deg,#D9CBAE,#B9A67D 55%,var(--rust) 130%);display:flex;align-items:center;justify-content:center;box-shadow:var(--shadow-l);}
.hero-visual svg{width:58%;color:#fff;opacity:.92;}
.hero-tag{position:absolute;bottom:24px;left:24px;background:var(--surface);padding:14px 18px;border-radius:var(--radius-m);box-shadow:var(--shadow-m);font-size:12px;max-width:190px;}
.hero-tag b{display:block;font-family:var(--serif);font-size:15px;margin-bottom:2px;}
.stat-row{display:flex;gap:40px;margin-top:40px;flex-wrap:wrap;}
.stat-row div b{display:block;font-family:var(--serif);font-size:26px;}
.stat-row div span{font-size:12px;color:var(--muted);}

/* ============ SECTIONS ============ */
section.pad{padding:80px 0;}
.section-head{display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:36px;gap:20px;flex-wrap:wrap;}
.section-head h2{font-size:32px;}
.section-head p{color:var(--muted);font-size:14px;margin-top:6px;max-width:440px;}

/* categories */
.cat-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:18px;}
@media(max-width:900px){.cat-grid{grid-template-columns:repeat(3,1fr);}}
@media(max-width:560px){.cat-grid{grid-template-columns:repeat(2,1fr);}}
.cat-card{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius-m);padding:26px 16px;text-align:center;transition:.2s;}
.cat-card:hover{transform:translateY(-4px);box-shadow:var(--shadow-m);border-color:var(--rust);}
.cat-card svg{width:30px;height:30px;margin:0 auto 12px;color:var(--rust);}
.cat-card b{font-size:13px;display:block;}
.cat-card span{font-size:11px;color:var(--muted);}

/* products grid */
.prod-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:26px;}
@media(max-width:980px){.prod-grid{grid-template-columns:repeat(3,1fr);}}
@media(max-width:720px){.prod-grid{grid-template-columns:repeat(2,1fr);gap:16px;}}
.card-prod{position:relative;background:var(--surface);border-radius:var(--radius-m);overflow:hidden;border:1px solid var(--border);transition:box-shadow .2s,transform .2s;}
.card-prod:hover{box-shadow:var(--shadow-m);transform:translateY(-3px);}
.card-media{position:relative;aspect-ratio:1/1.05;display:flex;align-items:center;justify-content:center;overflow:hidden;}
.card-media svg{width:44%;transition:transform .35s;color:rgba(33,29,24,.65)}
.card-prod:hover .card-media svg{transform:scale(1.08) rotate(-2deg);}
.tag-row{position:absolute;top:10px;left:10px;display:flex;gap:6px;z-index:2;}
.tag{font-size:10px;font-weight:700;padding:4px 8px;border-radius:2px;letter-spacing:.03em;}
.tag-sale{background:var(--rust);color:#fff;}
.tag-new{background:var(--sage);color:#fff;}
.tag-low{background:#3A352C;color:#fff;}
.wish-fab{position:absolute;top:10px;right:10px;z-index:2;width:32px;height:32px;border-radius:50%;background:#fff;display:flex;align-items:center;justify-content:center;box-shadow:var(--shadow-s);}
.wish-fab svg{width:16px;height:16px;}
.wish-fab.active svg{fill:var(--rust);color:var(--rust);}
.quick-view-btn{position:absolute;left:10px;right:10px;bottom:10px;background:var(--ink);color:#fff;font-size:11px;text-transform:uppercase;letter-spacing:.05em;padding:10px;text-align:center;border-radius:2px;opacity:0;transform:translateY(6px);transition:.2s;z-index:2;}
.card-prod:hover .quick-view-btn{opacity:1;transform:none;}
.card-body{padding:14px 16px 18px;}
.card-cat{font-size:10px;text-transform:uppercase;letter-spacing:.06em;color:var(--muted);margin-bottom:4px;}
.card-name{font-size:14px;font-weight:600;margin-bottom:6px;line-height:1.3;}
.card-rating{display:flex;align-items:center;gap:5px;font-size:11px;color:var(--muted);margin-bottom:8px;}
.stars{color:var(--gold);letter-spacing:1px;font-size:12px;}
.price-row{display:flex;align-items:center;gap:8px;margin-bottom:12px;}
.price{font-weight:700;font-size:15px;}
.price-old{font-size:12px;color:var(--muted);text-decoration:line-through;}
.discount-pct{font-size:11px;color:var(--rust);font-weight:700;}
.add-cart-btn{width:100%;padding:10px;font-size:11px;text-transform:uppercase;letter-spacing:.05em;font-weight:600;border:1px solid var(--ink);border-radius:2px;transition:.15s;}
.add-cart-btn:hover{background:var(--ink);color:#fff;}
.add-cart-btn.out{border-color:var(--border);color:var(--muted);}

/* offers band */
.offer-band{background:linear-gradient(120deg,var(--rust),#8C3D22);border-radius:var(--radius-l);padding:50px 46px;color:#fff;display:flex;justify-content:space-between;align-items:center;gap:30px;flex-wrap:wrap;}
.offer-band h3{color:#fff;font-size:30px;max-width:420px;}
.offer-band p{color:#F4DFC9;font-size:13px;margin-top:8px;}
.countdown{display:flex;gap:10px;margin-top:20px;}
.countdown div{background:rgba(255,255,255,.15);border-radius:6px;padding:8px 12px;text-align:center;min-width:56px;}
.countdown b{display:block;font-family:var(--serif);font-size:20px;}
.countdown span{font-size:9px;text-transform:uppercase;opacity:.8;}

/* reviews */
.review-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:22px;}
@media(max-width:800px){.review-grid{grid-template-columns:1fr;}}
.review-card{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius-m);padding:26px;}
.review-card .stars{margin-bottom:12px;display:block;}
.review-card p{font-size:14px;color:var(--ink-soft);margin-bottom:18px;}
.review-who{display:flex;align-items:center;gap:10px;}
.avatar{width:36px;height:36px;border-radius:50%;background:var(--surface-2);display:flex;align-items:center;justify-content:center;font-family:var(--serif);font-size:14px;color:var(--rust);}
.review-who b{font-size:13px;display:block;}
.review-who span{font-size:11px;color:var(--muted);}

/* breadcrumb */
.crumb{font-size:12px;color:var(--muted);padding:20px 0 6px;display:flex;gap:6px;flex-wrap:wrap;}
.crumb a:hover{color:var(--rust);}

/* shop layout */
.shop-layout{display:grid;grid-template-columns:240px 1fr;gap:40px;align-items:flex-start;}
@media(max-width:860px){.shop-layout{grid-template-columns:1fr;}}
.filter-panel{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius-m);padding:22px;position:sticky;top:120px;}
.filter-block{border-bottom:1px solid var(--border);padding-bottom:18px;margin-bottom:18px;}
.filter-block:last-child{border:none;margin:0;padding:0;}
.filter-block h4{font-size:12px;text-transform:uppercase;letter-spacing:.06em;margin-bottom:12px;font-family:var(--sans);font-weight:700;}
.filter-block label{display:flex;align-items:center;gap:8px;font-size:13px;padding:5px 0;color:var(--ink-soft);cursor:pointer;}
.filter-block input[type=checkbox],.filter-block input[type=radio]{accent-color:var(--rust);width:14px;height:14px;}
.range-row{display:flex;gap:8px;align-items:center;}
.range-row input{width:70px;padding:7px 8px;border:1px solid var(--border);border-radius:3px;}
.shop-toolbar{display:flex;justify-content:space-between;align-items:center;margin-bottom:22px;flex-wrap:wrap;gap:12px;}
.shop-toolbar select{padding:9px 12px;border:1px solid var(--border);border-radius:3px;font-size:13px;background:var(--surface);}
.pagination{display:flex;justify-content:center;gap:8px;margin-top:40px;}
.pagination button{width:36px;height:36px;border-radius:50%;border:1px solid var(--border);font-size:13px;}
.pagination button.active{background:var(--ink);color:#fff;border-color:var(--ink);}

/* product detail */
.pd-grid{display:grid;grid-template-columns:1fr 1fr;gap:56px;}
@media(max-width:860px){.pd-grid{grid-template-columns:1fr;}}
.pd-main-img{aspect-ratio:1/1;border-radius:var(--radius-l);display:flex;align-items:center;justify-content:center;margin-bottom:14px;}
.pd-main-img svg{width:46%;color:rgba(33,29,24,.7);}
.pd-thumbs{display:flex;gap:10px;}
.pd-thumbs div{width:70px;height:70px;border-radius:8px;border:2px solid transparent;display:flex;align-items:center;justify-content:center;cursor:pointer;}
.pd-thumbs div.active{border-color:var(--rust);}
.pd-thumbs svg{width:60%;color:var(--ink-soft);}
.pd-title{font-size:30px;margin:6px 0 10px;}
.pd-desc{color:var(--ink-soft);font-size:14px;margin:18px 0;line-height:1.7;}
.opt-row{margin-bottom:20px;}
.opt-row h5{font-size:12px;text-transform:uppercase;letter-spacing:.05em;margin-bottom:10px;}
.swatches{display:flex;gap:10px;flex-wrap:wrap;}
.swatch{width:34px;height:34px;border-radius:50%;border:2px solid transparent;cursor:pointer;position:relative;}
.swatch.active{border-color:var(--ink);}
.size-pill{padding:8px 16px;border:1px solid var(--border);border-radius:20px;font-size:12px;cursor:pointer;}
.size-pill.active{background:var(--ink);color:#fff;border-color:var(--ink);}
.qty-stepper{display:flex;align-items:center;border:1px solid var(--border);border-radius:3px;width:fit-content;}
.qty-stepper button{width:38px;height:40px;font-size:16px;}
.qty-stepper span{width:40px;text-align:center;font-size:14px;}
.pd-actions{display:flex;gap:12px;margin-top:22px;flex-wrap:wrap;}
.trust-row{display:flex;gap:22px;margin-top:26px;padding-top:22px;border-top:1px solid var(--border);flex-wrap:wrap;}
.trust-row div{display:flex;align-items:center;gap:8px;font-size:12px;color:var(--ink-soft);}
.trust-row svg{width:18px;height:18px;color:var(--sage);}
.tabs{display:flex;gap:28px;border-bottom:1px solid var(--border);margin:60px 0 30px;}
.tab-btn{padding:12px 0;font-size:13px;font-weight:600;color:var(--muted);border-bottom:2px solid transparent;text-transform:uppercase;letter-spacing:.03em;}
.tab-btn.active{color:var(--ink);border-color:var(--rust);}

/* cart drawer */
.overlay{position:fixed;inset:0;background:rgba(33,29,24,.45);z-index:90;opacity:0;pointer-events:none;transition:opacity .25s;}
.overlay.show{opacity:1;pointer-events:auto;}
.drawer{position:fixed;top:0;right:0;height:100%;width:420px;max-width:92vw;background:var(--bg);z-index:91;transform:translateX(100%);transition:transform .3s ease;display:flex;flex-direction:column;box-shadow:var(--shadow-l);}
.drawer.show{transform:translateX(0);}
.drawer-head{display:flex;justify-content:space-between;align-items:center;padding:22px 24px;border-bottom:1px solid var(--border);}
.drawer-head h3{font-size:19px;}
.drawer-body{flex:1;overflow-y:auto;padding:16px 24px;}
.cart-line{display:flex;gap:14px;padding:16px 0;border-bottom:1px solid var(--border);}
.cart-thumb{width:70px;height:70px;border-radius:8px;background:var(--surface-2);display:flex;align-items:center;justify-content:center;flex-shrink:0;}
.cart-thumb svg{width:55%;color:var(--ink-soft);}
.cart-line-info{flex:1;}
.cart-line-info b{font-size:13px;display:block;margin-bottom:3px;}
.cart-line-info span{font-size:11px;color:var(--muted);}
.cart-line-bottom{display:flex;justify-content:space-between;align-items:center;margin-top:8px;}
.mini-stepper{display:flex;align-items:center;border:1px solid var(--border);border-radius:3px;}
.mini-stepper button{width:26px;height:26px;font-size:14px;}
.mini-stepper span{width:26px;text-align:center;font-size:12px;}
.remove-x{font-size:11px;color:var(--muted);text-decoration:underline;}
.drawer-foot{border-top:1px solid var(--border);padding:20px 24px;background:var(--surface);}
.sum-row{display:flex;justify-content:space-between;font-size:13px;padding:5px 0;color:var(--ink-soft);}
.sum-row.total{font-weight:700;font-size:16px;color:var(--ink);padding-top:10px;border-top:1px solid var(--border);margin-top:6px;}

/* toasts */
.toast-wrap{position:fixed;top:20px;right:20px;z-index:200;display:flex;flex-direction:column;gap:10px;}
.toast{background:var(--ink);color:#fff;padding:14px 18px;border-radius:6px;font-size:13px;display:flex;align-items:center;gap:10px;box-shadow:var(--shadow-m);animation:slideIn .25s ease;min-width:220px;}
.toast.success{background:var(--success);}
.toast.error{background:var(--danger);}
@keyframes slideIn{from{opacity:0;transform:translateX(30px);}to{opacity:1;transform:none;}}

/* forms */
.form-card{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius-m);padding:36px;max-width:460px;margin:0 auto;}
.field{margin-bottom:16px;}
.field label{display:block;font-size:12px;font-weight:600;margin-bottom:6px;color:var(--ink-soft);}
.field input,.field select,.field textarea{width:100%;padding:12px 14px;border:1px solid var(--border);border-radius:4px;background:var(--surface);font-size:13px;}
.field input:focus,.field select:focus,.field textarea:focus{border-color:var(--rust);}
.field-row{display:grid;grid-template-columns:1fr 1fr;gap:14px;}
.field-error{color:var(--danger);font-size:11px;margin-top:5px;display:none;}
.field.has-error input{border-color:var(--danger);}
.field.has-error .field-error{display:block;}
.form-alt{text-align:center;margin-top:20px;font-size:13px;color:var(--muted);}

/* checkout */
.checkout-grid{display:grid;grid-template-columns:1.5fr 1fr;gap:44px;align-items:flex-start;}
@media(max-width:860px){.checkout-grid{grid-template-columns:1fr;}}
.co-section{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius-m);padding:26px;margin-bottom:22px;}
.co-section h3{font-size:16px;margin-bottom:16px;display:flex;align-items:center;gap:10px;}
.co-num{width:24px;height:24px;border-radius:50%;background:var(--rust);color:#fff;font-size:12px;display:flex;align-items:center;justify-content:center;font-family:var(--sans);}
.pay-option{display:flex;align-items:center;gap:12px;border:1px solid var(--border);border-radius:6px;padding:14px;margin-bottom:10px;cursor:pointer;}
.pay-option.active{border-color:var(--rust);background:#FBF3EE;}
.order-summary-card{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius-m);padding:26px;position:sticky;top:120px;}
.mini-line{display:flex;gap:10px;padding:9px 0;border-bottom:1px solid var(--border);align-items:center;}
.mini-line span.name{font-size:12px;flex:1;}
.coupon-row{display:flex;gap:8px;margin:16px 0;}
.coupon-row input{flex:1;padding:10px 12px;border:1px solid var(--border);border-radius:4px;font-size:12px;}

/* account / dashboard */
.dash-layout{display:grid;grid-template-columns:230px 1fr;gap:36px;}
@media(max-width:800px){.dash-layout{grid-template-columns:1fr;}}
.dash-nav{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius-m);padding:16px;height:fit-content;}
.dash-nav a{display:flex;align-items:center;gap:10px;padding:11px 14px;border-radius:6px;font-size:13px;font-weight:500;color:var(--ink-soft);}
.dash-nav a.active,.dash-nav a:hover{background:var(--surface-2);color:var(--ink);}
.dash-nav svg{width:16px;height:16px;}
.stat-card{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius-m);padding:22px;}
.stat-card b{font-family:var(--serif);font-size:28px;display:block;}
.stat-card span{font-size:12px;color:var(--muted);}
.stat-cards-row{display:grid;grid-template-columns:repeat(4,1fr);gap:18px;margin-bottom:30px;}
@media(max-width:760px){.stat-cards-row{grid-template-columns:1fr 1fr;}}
table.data-table{width:100%;border-collapse:collapse;background:var(--surface);border:1px solid var(--border);border-radius:var(--radius-m);overflow:hidden;}
table.data-table th{text-align:left;font-size:11px;text-transform:uppercase;letter-spacing:.05em;color:var(--muted);padding:14px 16px;background:var(--surface-2);}
table.data-table td{padding:14px 16px;font-size:13px;border-top:1px solid var(--border);}
.status-pill{font-size:11px;font-weight:700;padding:4px 10px;border-radius:20px;display:inline-block;}
.status-pending{background:#FDF2DA;color:#8A6416;}
.status-shipped{background:#E4EEF9;color:#2A5C8F;}
.status-delivered{background:var(--sage-light);color:var(--success);}
.status-cancelled{background:var(--danger-bg);color:var(--danger);}

/* track order */
.track-steps{display:flex;justify-content:space-between;position:relative;margin:50px 0;}
.track-steps::before{content:'';position:absolute;top:17px;left:5%;right:5%;height:2px;background:var(--border);}
.track-step{position:relative;text-align:center;flex:1;z-index:1;}
.track-dot{width:36px;height:36px;border-radius:50%;background:var(--surface);border:2px solid var(--border);margin:0 auto 10px;display:flex;align-items:center;justify-content:center;}
.track-step.done .track-dot{background:var(--sage);border-color:var(--sage);color:#fff;}
.track-step.current .track-dot{background:var(--rust);border-color:var(--rust);color:#fff;}
.track-step span{font-size:11px;color:var(--muted);display:block;}
.track-step.done span,.track-step.current span{color:var(--ink);font-weight:600;}

/* empty state */
.empty-state{text-align:center;padding:80px 20px;}
.empty-state svg{width:60px;height:60px;color:var(--border);margin-bottom:18px;}
.empty-state h3{margin-bottom:8px;}
.empty-state p{color:var(--muted);font-size:13px;margin-bottom:22px;}

/* modal */
.modal-back{position:fixed;inset:0;background:rgba(33,29,24,.5);z-index:150;display:none;align-items:center;justify-content:center;padding:20px;}
.modal-back.show{display:flex;}
.modal-box{background:var(--surface);border-radius:var(--radius-m);max-width:900px;width:100%;max-height:88vh;overflow:auto;position:relative;box-shadow:var(--shadow-l);}
.modal-close{position:absolute;top:16px;right:16px;width:34px;height:34px;border-radius:50%;background:var(--surface-2);display:flex;align-items:center;justify-content:center;z-index:5;}

/* misc */
.skel{background:linear-gradient(90deg,var(--surface-2) 25%,var(--border) 37%,var(--surface-2) 63%);background-size:400% 100%;animation:shimmer 1.4s infinite;border-radius:var(--radius-m);}
@keyframes shimmer{0%{background-position:100% 50%}100%{background-position:0 50%}}
.loader-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:26px;}
@media(max-width:720px){.loader-grid{grid-template-columns:repeat(2,1fr);}}
.skel-card{aspect-ratio:1/1.4;}

.badge-inline{font-size:10px;background:var(--sage-light);color:var(--success);padding:3px 8px;border-radius:20px;font-weight:700;text-transform:uppercase;}
.badge-inline.out{background:var(--danger-bg);color:var(--danger);}
.pd-price-row{display:flex;align-items:center;gap:12px;margin:14px 0;}
.pd-price-row .price{font-size:26px;}
.related-title{margin:80px 0 30px;}
.section-divider{height:1px;background:var(--border);margin:70px 0;}
::selection{background:var(--rust);color:#fff;}
.hidden{display:none!important;}
</style>
</head>
<body>

<div id="toastWrap" class="toast-wrap"></div>
<div id="overlay" class="overlay"></div>
<div id="app"></div>

<script>
/* =====================================================================
   STUDIO KOBO — client-side demo store
   In-memory data model stands in for the MySQL database described in
   the brief (see schema comment at bottom of file). Everything here —
   cart, wishlist, auth, orders, admin CRUD — is fully interactive.
===================================================================== */

/* ---------- ICONS (line-art placeholders used instead of stock photos) ---------- */
const ICONS = {
  mug: `<svg viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M22 30h44v34a14 14 0 0 1-14 14H36a14 14 0 0 1-14-14V30Z"/><path d="M66 38h8a10 10 0 0 1 0 20h-8"/><path d="M32 20c0-4 2-6 2-10M44 20c0-4 2-6 2-10M56 20c0-4 2-6 2-10" stroke-linecap="round"/></svg>`,
  bowl: `<svg viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M14 46h72a36 32 0 0 1-72 0Z"/><ellipse cx="50" cy="46" rx="36" ry="7"/><path d="M40 78l-4 8M60 78l4 8"/></svg>`,
  vase: `<svg viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M40 14h20l4 20-10 10c-6 6-6 8-2 16l6 12a10 10 0 0 1-9 16H41a10 10 0 0 1-9-16l6-12c4-8 4-10-2-16L26 34l4-20Z"/><path d="M40 14h20" /></svg>`,
  lamp: `<svg viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M28 30 50 14l22 16-8 16H36l-8-16Z"/><path d="M50 46v34M36 92h28"/><circle cx="50" cy="30" r="3" fill="currentColor" stroke="none"/></svg>`,
  chair: `<svg viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M26 20v40M26 20h40M74 44v36M26 60h48M32 60l-4 26M68 60l4 26"/></svg>`,
  blanket: `<svg viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M14 30h72v40a4 4 0 0 1-4 4H18a4 4 0 0 1-4-4V30Z"/><path d="M14 30l10-16h52l10 16M30 34v40M50 34v40M70 34v40"/></svg>`,
  candle: `<svg viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="2.2"><rect x="34" y="34" width="32" height="52" rx="3"/><path d="M50 34c-6-8-2-14 0-18 4 6 8 10 0 18Z"/></svg>`,
  tray: `<svg viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="2.2"><rect x="12" y="34" width="76" height="32" rx="8"/><circle cx="30" cy="50" r="1.5" fill="currentColor"/><path d="M20 34c0-8 4-12 8-12M80 34c0-8-4-12-8-12"/></svg>`,
  basket: `<svg viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M22 40h56l-6 40a6 6 0 0 1-6 5H34a6 6 0 0 1-6-5L22 40Z"/><path d="M22 40 34 20h32l12 20M40 50v22M60 50v22"/></svg>`,
  towel: `<svg viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M20 16h60v58a10 10 0 0 1-10 10H30a10 10 0 0 1-10-10V16Z"/><path d="M20 34h60M20 46h60"/></svg>`,
  planter: `<svg viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M30 40h40l-5 42a6 6 0 0 1-6 5H41a6 6 0 0 1-6-5L30 40Z"/><path d="M50 40c-4-14 2-22 0-30-14 4-16 16-8 26"/></svg>`,
  glass: `<svg viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M32 20h36l-6 60a6 6 0 0 1-6 5H44a6 6 0 0 1-6-5L32 20Z"/><path d="M32 20h36"/></svg>`,
  board: `<svg viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M18 30c0-8 6-14 14-14h36c8 0 14 6 14 14v30c0 8-6 14-14 14H32c-8 0-14-6-14-14V30Z"/><circle cx="76" cy="24" r="4"/></svg>`,
};
const iconKeys = Object.keys(ICONS);

/* ---------- CATEGORY ICONS ---------- */
const CAT_ICON = {Kitchen:ICONS.bowl,Lighting:ICONS.lamp,Textiles:ICONS.blanket,Furniture:ICONS.chair,Bath:ICONS.towel,Décor:ICONS.vase};

/* ---------- DATA: PRODUCTS ---------- */
const CATEGORIES = ["Kitchen","Lighting","Textiles","Furniture","Bath","Décor"];
const COLORS = {sand:"#D8CBAE",clay:"#B4693F",moss:"#6B7A5E",charcoal:"#3A352C",bone:"#EDE7D9"};

function makeProducts(){
  const names = [
    ["Hoji Stoneware Mug","Kitchen","mug"],["Ren Ceramic Bowl Set","Kitchen","bowl"],
    ["Nagi Table Vase","Décor","vase"],["Aro Arc Floor Lamp","Lighting","lamp"],
    ["Kobo Oak Dining Chair","Furniture","chair"],["Fen Wool Throw Blanket","Textiles","blanket"],
    ["Ember Soy Pillar Candle","Décor","candle"],["Elm Serving Tray","Kitchen","tray"],
    ["Sana Woven Storage Basket","Textiles","basket"],["Riko Waffle Bath Towel","Bath","towel"],
    ["Tomi Ceramic Planter","Décor","planter"],["Nori Tumbler Glass Set","Kitchen","glass"],
    ["Hako Walnut Cutting Board","Kitchen","board"],["Sumi Pendant Lamp","Lighting","lamp"],
    ["Iwa Lounge Chair","Furniture","chair"],["Kasa Linen Cushion Cover","Textiles","blanket"],
    ["Yama Stoneware Vase","Décor","vase"],["Chibi Espresso Cup Set","Kitchen","mug"],
    ["Fude Bath Mat","Bath","towel"],["Mizu Carafe & Glass Set","Kitchen","glass"],
    ["Take Bamboo Side Table","Furniture","chair"],["Hana Table Lamp","Lighting","lamp"],
    ["Origami Storage Bowl","Kitchen","bowl"],["Sora Woven Rug Runner","Textiles","blanket"],
  ];
  return names.map((n,i)=>{
    const id = "SK-"+String(100+i);
    const price = Math.round((28 + (i*7.3)%160) *100)/100;
    const onSale = i%3===0;
    const oldPrice = onSale ? Math.round(price*1.32*100)/100 : null;
    const rating = Math.round((3.6 + (i%5)*0.35)*10)/10;
    const reviews = 6 + (i*13)%180;
    const stock = i%9===0 ? 0 : (i%5===0 ? 3 : 20+i*2);
    return {
      id, name:n[0], category:n[1], icon:n[2],
      price, oldPrice, isNew: i%4===1, rating: Math.min(rating,5), reviews,
      stock, colors: (i%2===0)?["sand","clay","charcoal"]:["moss","bone"],
      sizes: (n[1]==="Textiles"||n[1]==="Bath")?["S","M","L"]:null,
      desc: `${n[0]} is hand-finished in small batches, pairing a quiet, considered silhouette with materials chosen to age well. Designed in-studio and made to be used daily, not just displayed.`,
      swatch: COLORS[(i%2===0)?"sand":"moss"],
    };
  });
}
const PRODUCTS = makeProducts();
function productById(id){return PRODUCTS.find(p=>p.id===id);}
function discountPct(p){return p.oldPrice ? Math.round((1-p.price/p.oldPrice)*100) : 0;}

const REVIEWS_HOME = [
  {name:"Marta H.",initial:"M",text:"Every piece feels like it was made to be kept for a decade, not a season. My kitchen finally feels like one coherent idea.",rating:5,role:"Verified buyer"},
  {name:"Devon R.",initial:"D",text:"Ordering was painless and the packaging alone told me this was a considered small business, not a marketplace reseller.",rating:5,role:"Verified buyer"},
  {name:"Priya S.",initial:"P",text:"The Aro floor lamp is the first thing guests ask about. Shipping was quick and the studio actually replies to email.",rating:4,role:"Verified buyer"},
];

/* ---------- STATE ---------- */
const state = {
  route: "#/home",
  cart: [],          // {id,color,size,qty}
  wishlist: [],       // ids
  user: null,        // {name,email}
  orders: [],
  coupon: null,
  isAdmin: false,
  filters: {cats:[], price:[0,400], rating:0, availability:"all", sort:"newest", q:"", page:1},
  pdActive: {color:null,size:null,qty:1,img:0},
};
const COUPONS = {"KOBO10":.10,"WELCOME15":.15};
const SHIP_COST = 6.5;
const FREE_SHIP_OVER = 120;

function cartCount(){return state.cart.reduce((a,l)=>a+l.qty,0);}
function cartSubtotal(){return state.cart.reduce((a,l)=>a+productById(l.id).price*l.qty,0);}
function cartTotal(){
  const sub = cartSubtotal();
  const ship = sub===0 ? 0 : (sub>=FREE_SHIP_OVER?0:SHIP_COST);
  const discount = state.coupon ? sub*state.coupon.pct : 0;
  return {sub, ship, discount, total: Math.max(sub+ship-discount,0)};
}

/* ---------- TOASTS ---------- */
function toast(msg, type="default"){
  const wrap = document.getElementById('toastWrap');
  const el = document.createElement('div');
  el.className = 'toast '+(type==='success'?'success':type==='error'?'error':'');
  el.textContent = msg;
  wrap.appendChild(el);
  setTimeout(()=>{el.style.opacity='0';el.style.transform='translateX(30px)';el.style.transition='.2s';setTimeout(()=>el.remove(),200);},2600);
}

/* ---------- HELPERS ---------- */
function stars(rating){
  const full = Math.round(rating);
  return `<span class="stars">${'★'.repeat(full)}${'☆'.repeat(5-full)}</span>`;
}
function money(n){return '$'+n.toFixed(2);}
function nav(hash){ window.location.hash = hash; }
function qs(sel,root=document){return root.querySelector(sel);}
function qsa(sel,root=document){return [...root.querySelectorAll(sel)];}

/* =====================================================================
   ROUTER
===================================================================== */
window.addEventListener('hashchange', render);
window.addEventListener('DOMContentLoaded', ()=>{ if(!window.location.hash) window.location.hash='#/home'; render(); });

function render(){
  const hash = window.location.hash || '#/home';
  state.route = hash;
  window.scrollTo(0,0);
  closeDrawer();
  const [ , path, param ] = hash.split('/');
  let html = '';
  switch(path){
    case 'home': html = viewHome(); break;
    case 'shop': html = viewShop(); break;
    case 'product': html = viewProduct(param); break;
    case 'categories': html = viewCategories(); break;
    case 'cart': html = viewCartPage(); break;
    case 'checkout': html = viewCheckout(); break;
    case 'login': html = viewAuth('login'); break;
    case 'register': html = viewAuth('register'); break;
    case 'account': html = viewAccount(param||'profile'); break;
    case 'wishlist': html = viewWishlist(); break;
    case 'track': html = viewTrack(); break;
    case 'about': html = viewAbout(); break;
    case 'contact': html = viewContact(); break;
    case 'admin': html = viewAdmin(param||'overview'); break;
    case 'order-confirmed': html = viewOrderConfirmed(param); break;
    default: html = viewHome();
  }
  document.getElementById('app').innerHTML = shell(html);
  wireGlobal();
  wireView(path, param);
}

