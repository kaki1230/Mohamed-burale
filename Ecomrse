          <div class="range-row"><input type="number" id="priceMin" value="${f.price[0]}" min="0"> – <input type="number" id="priceMax" value="${f.price[1]}" min="0"></div>
        </div>
        <div class="filter-block">
          <h4>Rating</h4>
          ${[4,3,2].map(r=>`<label><input type="radio" name="ratingFilt" class="filtRating" value="${r}" ${f.rating==r?'checked':''}> ${r}★ & up</label>`).join('')}
          <label><input type="radio" name="ratingFilt" class="filtRating" value="0" ${f.rating==0?'checked':''}> Any rating</label>
        </div>
        <div class="filter-block">
          <h4>Availability</h4>
          <label><input type="radio" name="availFilt" class="filtAvail" value="all" ${f.availability==='all'?'checked':''}> All</label>
          <label><input type="radio" name="availFilt" class="filtAvail" value="in" ${f.availability==='in'?'checked':''}> In stock</label>
          <label><input type="radio" name="availFilt" class="filtAvail" value="out" ${f.availability==='out'?'checked':''}> Out of stock</label>
        </div>
        <button class="btn btn-outline btn-block btn-sm" id="clearFilters">Clear Filters</button>
      </aside>
      <div>
        <div class="shop-toolbar">
          <span style="font-size:13px;color:var(--muted);">Showing ${pageItems.length} of ${list.length}</span>
          <select id="sortSelect">
            <option value="newest" ${f.sort==='newest'?'selected':''}>Newest</option>
            <option value="price-asc" ${f.sort==='price-asc'?'selected':''}>Price: Low to High</option>
            <option value="price-desc" ${f.sort==='price-desc'?'selected':''}>Price: High to Low</option>
            <option value="popular" ${f.sort==='popular'?'selected':''}>Most Popular</option>
