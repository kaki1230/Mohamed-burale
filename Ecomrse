function parseQueryFromHash(){
  const q = state.route.split('?')[1];
  const params = new URLSearchParams(q||'');
  if(params.get('cat') && !state.filters.cats.includes(params.get('cat'))){
    state.filters.cats = [params.get('cat')];
  }
}
function filteredProducts(){
  let list = [...PRODUCTS];
  const f = state.filters;
  if(f.q) list = list.filter(p=>p.name.toLowerCase().includes(f.q.toLowerCase()));
  if(f.cats.length) list = list.filter(p=>f.cats.includes(p.category));
  list = list.filter(p=>p.price>=f.price[0] && p.price<=f.price[1]);
  if(f.rating) list = list.filter(p=>p.rating>=f.rating);
  if(f.availability==='in') list = list.filter(p=>p.stock>0);
  if(f.availability==='out') list = list.filter(p=>p.stock===0);
  switch(f.sort){
    case 'price-asc': list.sort((a,b)=>a.price-b.price); break;
    case 'price-desc': list.sort((a,b)=>b.price-a.price); break;
    case 'popular': list.sort((a,b)=>b.reviews-a.reviews); break;
    case 'rated': list.sort((a,b)=>b.rating-a.rating); break;
    default: list.sort((a,b)=>b.isNew-a.isNew);
  }
  return list;
}
function viewShop(){
  parseQueryFromHash();
  const list = filteredProducts();
  const perPage = 8;
  const pages = Math.max(1,Math.ceil(list.length/perPage));
  if(state.filters.page>pages) state.filters.page=1;
  const pageItems = list.slice((state.filters.page-1)*perPage, state.filters.page*perPage);
  const f = state.filters;
  return `
  <div class="wrap">
    <div class="crumb"><a href="#/home">Home</a> / Shop</div>
    <div class="section-head"><div><h2>Shop All</h2><p>${list.length} products</p></div></div>
