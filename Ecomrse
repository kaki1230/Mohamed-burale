/* =====================================================================
   WIRING: events per view
===================================================================== */
function wireGlobal(){
  qs('#cartOpenBtn')?.addEventListener('click', openDrawer);
  qs('#cartCloseBtn')?.addEventListener('click', closeDrawer);
  qs('#overlay')?.addEventListener('click', ()=>{closeDrawer(); closeModal();});
  qs('#burgerBtn')?.addEventListener('click', ()=>{
    const nav = qs('#mainNav'); nav.style.display = nav.style.display==='flex'?'':'flex'; nav.style.flexDirection='column'; nav.style.alignItems='flex-start';
  });
  qs('#newsletterForm')?.addEventListener('submit', e=>{e.preventDefault(); toast('Subscribed! Check your inbox.','success'); e.target.reset();});

  // search
  const doSearch = (val)=>{ state.filters.q = val; state.filters.page=1; if(!state.route.startsWith('#/shop')) nav('#/shop'); else render(); };
  qs('#searchInput')?.addEventListener('keydown', e=>{if(e.key==='Enter') doSearch(e.target.value);});
  qs('#searchInputMobile')?.addEventListener('keydown', e=>{if(e.key==='Enter') doSearch(e.target.value);});

  // wishlist toggles (delegated, global because they appear in drawer-adjacent areas too)
  qsa('[data-wish]').forEach(btn=>btn.addEventListener('click', e=>{
    e.preventDefault(); const id = btn.getAttribute('data-wish');
    const idx = state.wishlist.indexOf(id);
    if(idx>-1){state.wishlist.splice(idx,1); toast('Removed from wishlist');}
    else {state.wishlist.push(id); toast('Added to wishlist','success');}
    render();
  }));

  // add to cart (grid cards)
  qsa('[data-addcart]').forEach(btn=>btn.addEventListener('click', e=>{
    e.preventDefault();
    const id = btn.getAttribute('data-addcart');
    addToCart(id, null, null, 1);
  }));

  // quick view
  qsa('[data-qv]').forEach(btn=>btn.addEventListener('click', e=>{
    e.preventDefault(); openQuickView(btn.getAttribute('data-qv'));
  }));
  qs('#quickViewModal')?.addEventListener('click', e=>{ if(e.target.id==='quickViewModal') closeModal(); });

  // category card clicks set filter before nav (handled by hash anyway), ensure filter resets on new cat
  qsa('.cat-link').forEach(a=>a.addEventListener('click', ()=>{ state.filters.cats=[a.dataset.cat]; state.filters.page=1; }));

  // cart drawer line controls (delegated within drawer, present on all pages)
  wireCartLines(qs('#cartDrawer'));
}

function wireCartLines(container){
  if(!container) return;
  qsa('.cart-line', container).forEach(line=>{
    const [id,color,size] = line.dataset.line.split('|');
    line.querySelector('.qtyInc').addEventListener('click', ()=>changeQty(id,color,size,1));
    line.querySelector('.qtyDec').addEventListener('click', ()=>changeQty(id,color,size,-1));
    line.querySelector('.lineRemove').addEventListener('click', ()=>removeLine(id,color,size));
  });
}

function addToCart(id,color,size,qty){
  const p = productById(id);
  if(!p || p.stock===0) return;
  const existing = state.cart.find(l=>l.id===id && l.color===color && l.size===size);
  if(existing) existing.qty += qty; else state.cart.push({id,color,size,qty});
  toast(`${p.name} added to cart`,'success');
  render(); openDrawer();
}
function changeQty(id,color,size,delta){
  const line = state.cart.find(l=>l.id===id && l.color===(color==='null'?null:color) && l.size===(size==='null'?null:size));
  if(!line) return;
  line.qty += delta;
  if(line.qty<=0) state.cart = state.cart.filter(l=>l!==line);
  render(); openDrawer();
}
function removeLine(id,color,size){
  state.cart = state.cart.filter(l=>!(l.id===id && l.color===(color==='null'?null:color) && l.size===(size==='null'?null:size)));
  toast('Removed from cart');
  render(); openDrawer();
}

function openQuickView(id){
  const p = productById(id);
  const body = qs('#quickViewBody');
  body.innerHTML = `
    <button class="modal-close" id="qvClose">${svgClose()}</button>
    <div class="pd-grid" style="padding:36px;gap:34px;">
      <div class="pd-main-img" style="background:${softBg(p.swatch)};aspect-ratio:1/1;">${ICONS[p.icon]}</div>
      <div>
        <div class="card-cat">${p.category}</div>
        <h2 style="font-size:24px;margin:6px 0 10px;">${p.name}</h2>
        <div class="card-rating">${stars(p.rating)} <span>${p.rating} (${p.reviews})</span></div>
        <div class="pd-price-row"><span class="price">${money(p.price)}</span>${p.oldPrice?`<span class="price-old">${money(p.oldPrice)}</span>`:''}</div>
        <p class="pd-desc">${p.desc}</p>
        <div class="pd-actions">
          <button class="btn btn-primary" id="qvAddCart" ${p.stock===0?'disabled':''}>${p.stock===0?'Out of Stock':'Add to Cart'}</button>
          <a href="#/product/${p.id}" class="btn btn-outline" id="qvFullDetails">Full Details</a>
        </div>
      </div>
    </div>`;
  qs('#quickViewModal').classList.add('show');
  qs('#overlay').classList.add('show');
  qs('#qvClose').addEventListener('click', closeModal);
  qs('#qvAddCart').addEventListener('click', ()=>{addToCart(p.id,null,null,1); closeModal();});
  qs('#qvFullDetails').addEventListener('click', closeModal);
}
function closeModal(){ qs('#quickViewModal')?.classList.remove('show'); if(!qs('.drawer.show')) qs('#overlay')?.classList.remove('show'); }

function markFieldError(fieldId, isError){
  const f = document.getElementById(fieldId);
  if(!f) return;
  f.classList.toggle('has-error', isError);
}
function validEmail(v){return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v);}

function wireView(path, param){
  if(path==='shop') wireShop();
  if(path==='product') wireProduct(param);
  if(path==='cart') wireCartPage();
  if(path==='checkout') wireCheckout();
  if(path==='login') wireAuth('login');
  if(path==='register') wireAuth('register');
  if(path==='account') wireAccount(param);
  if(path==='admin') wireAdmin(param);
  if(path==='track') wireTrack();
  if(path==='contact') wireContact();
  if(path==='home') wireCountdown();
}

function wireCountdown(){
  let h=18,m=42,s=9;
  clearInterval(window.__cdInt);
  window.__cdInt = setInterval(()=>{
    if(!qs('#cdS')) {clearInterval(window.__cdInt); return;}
    s--; if(s<0){s=59;m--;} if(m<0){m=59;h--;} if(h<0){h=18;m=42;s=9;}
    qs('#cdH').textContent=String(h).padStart(2,'0');
    qs('#cdM').textContent=String(m).padStart(2,'0');
    qs('#cdS').textContent=String(s).padStart(2,'0');
  },1000);
}

function wireShop(){
  qs('#shopSearch')?.addEventListener('input', e=>{state.filters.q=e.target.value; state.filters.page=1; render();});
  qsa('.filtCat').forEach(cb=>cb.addEventListener('change', ()=>{
    state.filters.cats = qsa('.filtCat').filter(c=>c.checked).map(c=>c.value); state.filters.page=1; render();
  }));
  qs('#priceMin')?.addEventListener('change', e=>{state.filters.price[0]=Number(e.target.value)||0; render();});
  qs('#priceMax')?.addEventListener('change', e=>{state.filters.price[1]=Number(e.target.value)||400; render();});
  qsa('.filtRating').forEach(r=>r.addEventListener('change', e=>{state.filters.rating=Number(e.target.value); render();}));
  qsa('.filtAvail').forEach(r=>r.addEventListener('change', e=>{state.filters.availability=e.target.value; render();}));
  qs('#sortSelect')?.addEventListener('change', e=>{state.filters.sort=e.target.value; render();});
  qs('#clearFilters')?.addEventListener('click', ()=>{state.filters={cats:[],price:[0,400],rating:0,availability:'all',sort:'newest',q:'',page:1}; render();});
  qsa('.pageBtn').forEach(b=>b.addEventListener('click', ()=>{state.filters.page=Number(b.dataset.page); render();}));
}

function wireProduct(id){
  const p = productById(id);
  if(!p) return;
  qsa('.pdColor').forEach(el=>el.addEventListener('click', ()=>{qsa('.pdColor').forEach(x=>x.classList.remove('active')); el.classList.add('active'); state.pdActive.color=el.dataset.color;}));
  qsa('.pdSize').forEach(el=>el.addEventListener('click', ()=>{qsa('.pdSize').forEach(x=>x.classList.remove('active')); el.classList.add('active'); state.pdActive.size=el.dataset.size;}));
  qs('#pdQtyInc')?.addEventListener('click', ()=>{state.pdActive.qty++; qs('#pdQtyVal').textContent=state.pdActive.qty;});
  qs('#pdQtyDec')?.addEventListener('click', ()=>{if(state.pdActive.qty>1)state.pdActive.qty--; qs('#pdQtyVal').textContent=state.pdActive.qty;});
  qs('#pdAddCart')?.addEventListener('click', ()=>addToCart(p.id, state.pdActive.color, state.pdActive.size, state.pdActive.qty));
  qs('#pdBuyNow')?.addEventListener('click', ()=>{addToCart(p.id, state.pdActive.color, state.pdActive.size, state.pdActive.qty); nav('#/checkout');});
  qs('#pdWish')?.addEventListener('click', ()=>{
    const idx = state.wishlist.indexOf(p.id);
    if(idx>-1) state.wishlist.splice(idx,1); else state.wishlist.push(p.id);
    render();
  });
  qsa('.tab-btn').forEach(t=>t.addEventListener('click', ()=>{
    qsa('.tab-btn').forEach(x=>x.classList.remove('active')); t.classList.add('active');
    ['desc','specs','reviews'].forEach(k=>qs('#tab'+k[0].toUpperCase()+k.slice(1))?.classList.add('hidden'));
    qs('#tab'+t.dataset.tab[0].toUpperCase()+t.dataset.tab.slice(1))?.classList.remove('hidden');
  }));
  qs('#submitReview')?.addEventListener('click', ()=>{
    const txt = qs('#reviewText').value.trim();
    if(!txt){toast('Please write a review first','error'); return;}
    toast('Review submitted — thank you!','success');
    qs('#reviewText').value='';
  });
}

function wireCartPage(){
  wireCartLines(document.getElementById('app'));
  qs('#applyCoupon')?.addEventListener('click', ()=>{
    const code = qs('#couponInput').value.trim().toUpperCase();
    if(COUPONS[code]){state.coupon={code,pct:COUPONS[code]}; toast('Coupon applied!','success');}
    else {toast('Invalid coupon code','error');}
    render();
  });
}

function wireCheckout(){
  qsa('[data-ship]').forEach(el=>el.addEventListener('click', ()=>{qsa('[data-ship]').forEach(x=>x.classList.remove('active')); el.classList.add('active');}));
  qsa('[data-pay]').forEach(el=>el.addEventListener('click', ()=>{
    qsa('[data-pay]').forEach(x=>x.classList.remove('active')); el.classList.add('active');
    qs('#cardFields').style.display = el.dataset.pay==='card' ? '' : 'none';
  }));
  qs('#ckApplyCoupon')?.addEventListener('click', ()=>{
    const code = qs('#ckCoupon').value.trim().toUpperCase();
    if(COUPONS[code]){state.coupon={code,pct:COUPONS[code]}; toast('Coupon applied!','success');}
    else {toast('Invalid coupon code','error');}
    render();
  });
  qs('#placeOrderBtn')?.addEventListener('click', ()=>{
    let valid = true;
    const checks = [['fFullName','ckName',v=>v.trim().length>1],['fEmail','ckEmail',validEmail],['fPhone','ckPhone',v=>v.trim().length>=7],['fAddress','ckAddress',v=>v.trim().length>3],['fCity','ckCity',v=>v.trim().length>1]];
    checks.forEach(([fid,iid,test])=>{
      const val = qs('#'+iid)?.value||'';
      const ok = test(val);
      markFieldError(fid, !ok);
      if(!ok) valid=false;
    });
    if(!valid){toast('Please fix the highlighted fields','error'); return;}
    const t = cartTotal();
    const order = {
      id: 'SK-ORD-'+Math.floor(10000+Math.random()*89999),
      date: new Date().toLocaleDateString(),
      items: [...state.cart],
      total: t.total,
      status: 'pending',
      name: qs('#ckName').value,
      email: qs('#ckEmail').value,
      address: `${qs('#ckAddress').value}, ${qs('#ckCity').value}, ${qs('#ckCountry').value}`,
      eta: new Date(Date.now()+5*86400000).toLocaleDateString(),
    };
    state.orders.push(order);
    state.cart = [];
    state.coupon = null;
    toast('Order placed!','success');
    nav('#/order-confirmed/'+order.id);
  });
}

function wireAuth(mode){
  qs('#authSubmit')?.addEventListener('click', ()=>{
    let valid = true;
    if(mode==='register'){
      const ok = (qs('#regName').value.trim().length>1);
      markFieldError('fRegName', !ok); if(!ok) valid=false;
    }
    const emailOk = validEmail(qs('#authEmail').value);
    markFieldError('fAuthEmail', !emailOk); if(!emailOk) valid=false;
    const passOk = qs('#authPass').value.length>=6;
    markFieldError('fAuthPass', !passOk); if(!passOk) valid=false;
    if(!valid){toast('Please fix the highlighted fields','error'); return;}
    state.user = {name: mode==='register'?qs('#regName').value:qs('#authEmail').value.split('@')[0], email: qs('#authEmail').value};
    toast(mode==='register'?'Account created!':'Logged in!','success');
    nav('#/account/profile');
  });
}

function wireAccount(sub){
  qs('#logoutBtn')?.addEventListener('click', e=>{e.preventDefault(); state.user=null; toast('Logged out'); nav('#/home');});
  qs('#saveProfileBtn')?.addEventListener('click', ()=>{
    state.user.name = qs('#profName').value; state.user.email = qs('#profEmail').value;
    toast('Profile updated','success');
  });
}

function wireAdmin(sub){
  qs('#adminAddProduct')?.addEventListener('click', ()=>toast('Demo mode: product created (not persisted)','success'));
  qsa('.adminEditProd').forEach(b=>b.addEventListener('click', ()=>toast('Demo mode: edit form would open here')));
  qsa('.adminDelProd').forEach(b=>b.addEventListener('click', ()=>toast('Demo mode: product removed (not persisted)','success')));
  qsa('.adminStatusSelect').forEach(sel=>sel.addEventListener('change', ()=>{
    const order = state.orders.find(o=>o.id===sel.dataset.oid);
    if(order){order.status=sel.value; toast(`Order ${order.id} marked ${sel.value}`,'success');}
  }));
  qs('#createCouponBtn')?.addEventListener('click', ()=>{
    const code = qs('#newCouponCode').value.trim().toUpperCase();
    const pct = Number(qs('#newCouponPct').value)/100;
    if(!code || !pct){toast('Enter a code and percentage','error'); return;}
    COUPONS[code]=pct; toast('Coupon created','success'); render();
  });
}

function wireTrack(){
  qs('#trackBtn')?.addEventListener('click', doTrack);
  qs('#trackInput')?.addEventListener('keydown', e=>{if(e.key==='Enter') doTrack();});
}
function doTrack(){
  const val = qs('#trackInput').value.trim();
  const order = state.orders.find(o=>o.id===val);
  const statuses = ['placed','processing','shipped','out','delivered'];
  let status = 'processing';
  if(order) status = order.status==='pending'?'placed':order.status==='delivered'?'delivered':order.status==='shipped'?'shipped':'processing';
  else if(!val){toast('Enter an order ID','error'); return;}
  qs('#trackResult').innerHTML = `
    <div class="stat-card" style="margin-bottom:6px;">
      <b style="font-size:16px;">${val}</b><span>${order? 'Shipping to '+order.address : 'Demo tracking (order not found in this session — showing sample status)'}</span>
    </div>
    ${trackStepsHTML(status)}
  `;
}

function wireContact(){
  qs('#contactSubmit')?.addEventListener('click', ()=>{
    let valid = true;
    const checks = [['fCName','cName',v=>v.trim().length>1],['fCEmail','cEmail',validEmail],['fCMsg','cMsg',v=>v.trim().length>3]];
    checks.forEach(([fid,iid,test])=>{
      const ok = test(qs('#'+iid).value||'');
      markFieldError(fid, !ok); if(!ok) valid=false;
    });
    if(!valid){toast('Please fix the highlighted fields','error'); return;}
    toast('Message sent — we will reply within a day','success');
    qs('#cName').value=''; qs('#cEmail').value=''; qs('#cSubject').value=''; qs('#cMsg').value='';
  });
}
</script>
</body>
</html>
